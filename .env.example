# ── The Milkman — environment template ───────────────────────────────
# Copy to .env and fill in real values. Never commit .env.
# All times are Africa/Nairobi (UTC+3).

# API
API_PORT=3001
NODE_ENV=development

# PostgreSQL + PostGIS (also consumed by docker-compose.yml)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=milkman
DATABASE_PASSWORD=milkman_dev
DATABASE_NAME=milkman

# Redis (BullMQ arrives in Phase 4; the container runs from day one)
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Seed script credentials (Phase 1 seed creates 1 admin + 2 riders)
SEED_ADMIN_EMAIL=admin@milkman.co.ke
SEED_ADMIN_PASSWORD=ChangeMe_Admin_254
SEED_RIDER_PHONE_1=+254700111001
SEED_RIDER_PHONE_2=+254700111002
SEED_RIDER_PASSWORD=ChangeMe_Rider_254

# Depot — the point every distance/geofence check is measured from.
# Default is Nairobi CBD; replace with your real depot location.
DEPOT_LAT=-1.286389
DEPOT_LNG=36.817244

# Business rules (reference only; enforced in packages/shared constants)
# PACK_PRICE_KSH=50
# BICYCLE: <=2.5 km, <=35 packs/run
# MOTORCYCLE: 2.5-10 km, <=100 packs/run
# ORDER INTAKE: 08:00-22:00, cut-off 22:00
# DELIVERY WINDOW: 05:30-08:00

# ── Later phases (leave blank for now) ────────────────────────────────
# Daraja (M-Pesa STK Push) — Phase 6
# DARAJA_CONSUMER_KEY=
# DARAJA_CONSUMER_SECRET=
# DARAJA_SHORTCODE=
# DARAJA_CALLBACK_URL=
# WhatsApp Business Cloud API — Phase 4
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# Resend / SES — Phase 4
# RESEND_API_KEY=
# Cloudflare Turnstile — Phase 3
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
